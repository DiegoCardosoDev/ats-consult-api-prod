# Banco de dados (usado pelo docker-compose.prod.yml)
POSTGRES_DB=ats_db
POSTGRES_USER=ats
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Sessao opaca no servidor
SESSION_TIMEOUT=30m
SESSION_COOKIE_NAME=ats_session

# Administrador inicial (criado apenas se ambos estiverem definidos)
APP_ADMIN_EMAIL=admin@seudominio.com
APP_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Auto-registo publico (desativado por padrao em producao)
REGISTRATION_ENABLED=false

# Dominio publico apontando para a VM (ex.: DuckDNS ou dominio proprio)
DOMAIN=ats.seudominio.com

# Cookies: em HTTPS use true. Se front e API estiverem em dominios diferentes,
# use COOKIE_SAME_SITE=None (exige COOKIE_SECURE=true).
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# CORS: deixe vazio quando o Angular e servido pela mesma origem da API.
# Se o front estiver em outro dominio, informe a origem exata:
# CORS_ALLOWED_ORIGINS=https://app.seudominio.com
CORS_ALLOWED_ORIGINS=


# Rate limiting de login/registo
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_IP_MAX_ATTEMPTS=50
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ENTRIES=50000
