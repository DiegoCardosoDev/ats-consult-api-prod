{
  "info": {
    "_postman_id": "c1a9f4d2-7b6e-4c3a-9f21-8d0e6b7a5c42",
    "name": "ATS TN Consultoria",
    "description": "Collection da API do ATS (consult.api).\n\nComo usar:\n1. Ajuste `base_url` (padrão http://localhost:8080).\n2. Execute `Autenticação > Login` com um usuário ADMIN ou TECH_RECRUITER. O token é extraído do cookie `auth_token`.\n3. Execute as pastas na ordem: Clientes, Tecnologias, Vagas, Formulário, Processos, Candidaturas/Kanban e Comentários.\n4. As variáveis de ID são preenchidas automaticamente pelos testes das requisições de criação.\n\nAutenticação: cookie HttpOnly `auth_token` (Postman mantém o cookie automaticamente). A collection também define Authorization Bearer com a variável `token`, aceita pelo backend como fallback.\n\nCSRF: habilitado em produção. Execute `Autenticação > CSRF` antes das escritas. Em desenvolvimento (`spring.profiles.active=dev`) o CSRF está desabilitado.\n\nUploads: nas requisições multipart, selecione um arquivo PDF real no campo `resume` (o placeholder `/path/to/resume.pdf` não existe por padrão).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const method = pm.request.method.toUpperCase();",
          "if (!['GET', 'HEAD', 'OPTIONS'].includes(method)) {",
          "  try {",
          "    const xsrf = pm.cookies.get('XSRF-TOKEN');",
          "    if (xsrf) {",
          "      pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: decodeURIComponent(xsrf) });",
          "    }",
          "  } catch (e) {",
          "    console.warn('Não foi possível ler o cookie CSRF:', e.message);",
          "  }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Sem erro 5xx', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "admin_email", "value": "admin@tnconsultoria.com", "type": "string" },
    { "key": "admin_password", "value": "123456", "type": "string" },
    { "key": "client_id", "value": "1", "type": "string" },
    { "key": "technology_id", "value": "1", "type": "string" },
    { "key": "candidate_id", "value": "1", "type": "string" },
    { "key": "job_position_id", "value": "1", "type": "string" },
    { "key": "form_question_id", "value": "1", "type": "string" },
    { "key": "selection_process_id", "value": "1", "type": "string" },
    { "key": "application_id", "value": "1", "type": "string" },
    { "key": "comment_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Autenticação",
      "description": "Login por cookie e suporte a CSRF.",
      "item": [
        {
          "name": "CSRF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF gerado (204)', function () {",
                  "  pm.expect(pm.response.code).to.eql(204);",
                  "});",
                  "const xsrf = pm.cookies.get('XSRF-TOKEN');",
                  "if (xsrf) {",
                  "  console.log('Cookie XSRF-TOKEN disponível para o pre-request script.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/csrf",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "csrf"]
            },
            "description": "Gera o cookie XSRF-TOKEN. Necessário quando CSRF_ENABLED=true."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login efetuado', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let cookieToken = null;",
                  "try { cookieToken = pm.cookies.get('auth_token'); } catch (e) { cookieToken = null; }",
                  "if (!cookieToken) {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "  const match = setCookie.match(/auth_token=([^;]+)/);",
                  "  if (match) { cookieToken = match[1]; }",
                  "}",
                  "if (cookieToken) {",
                  "  pm.collectionVariables.set('token', cookieToken);",
                  "  pm.test('Token extraído do cookie', function () {",
                  "    pm.expect(cookieToken.length).to.be.above(20);",
                  "  });",
                  "} else {",
                  "  console.warn('Token não encontrado no Set-Cookie; verifique o cookie auth_token no Postman.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Autentica e devolve Set-Cookie auth_token (HttpOnly)."
          },
          "response": []
        },
        {
          "name": "Registar usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registo criado', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"novo.usuario.{{$timestamp}}@example.com\",\n  \"password\": \"senhaSegura123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Cria usuário com papel USER e devolve cookie de autenticação."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout efetuado', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Invalida o token atual e limpa o cookie."
          },
          "response": []
        }
      ]
    },
